# Edu Agent repository ignore rules.
# Keep source/docs trackable; ignore local runtime data and generated artifacts.

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
venv/
.venv/
env/

# ── Node / Next.js ─────────────────────────────────────
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment / Secrets ──────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Local IDE / Editor ─────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Database / Runtime Storage ─────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma_db/
data/

# ── Generated Data / Logs ──────────────────────────────
backend/data/
logs/
*.log

# ── Local Knowledge / Thesis Materials ─────────────────
knowledge/general/
knowledge/answers/
docs/

# ── OS Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary / Scratch Scripts ────────────────────────
# 仅忽略仓库根目录的临时脚本；src/**/_*.py（如 _validate.py、_metadata_spec.py）
# 是正式模块，必须入库 —— 曾用 `_*.py` 全局匹配导致 clone/CI 缺文件。
/_*.py
!__init__.py
# 根目录下的临时目录：主要是 `pytest --basetemp=./_xxx` 的产物。
# 不忽略的话，一次本地跑测就会在 git status 里留下上千个 untracked 条目。
# 注意 CI 里的门禁用 tempfile.mkdtemp()（系统临时目录），不会产生这里的目录。
/_*/

# ── Claude Code 会话状态 ────────────────────────────────
# 只忽略 worktrees（每次会话的临时检出，内含整份仓库副本）；
# .claude/ 下的 hooks / settings / skills 属于可版本化的项目配置，保留可提交。
.claude/worktrees/

# ── 本地 Agent 工具运行时数据 ───────────────────────────
# .mimosa/    ：代码审查 hook 的台账/基线快照（含整份文件副本，体积大）
# .workbuddy-ai/：本地会话记忆目录，属个人环境状态，不应入库
.mimosa/
.workbuddy-ai/
_e2e_artifacts/
