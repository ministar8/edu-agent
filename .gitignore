# Edu Agent repository ignore rules.
# Keep source/docs trackable; ignore local runtime data and generated artifacts.

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
venv/
.venv/
env/

# ── Node / Next.js ─────────────────────────────────────
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment / Secrets ──────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Local IDE / Editor ─────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Database / Runtime Storage ─────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma_db/
data/

# ── Generated Data / Logs ──────────────────────────────
backend/data/
logs/
*.log

# ── Local Knowledge / Thesis Materials ─────────────────
knowledge/general/
knowledge/answers/
docs/

# ── OS Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary / Scratch Scripts ────────────────────────
_*.py
!__init__.py

# ── Claude Code 会话状态 ────────────────────────────────
# 只忽略 worktrees（每次会话的临时检出，内含整份仓库副本）；
# .claude/ 下的 hooks / settings / skills 属于可版本化的项目配置，保留可提交。
.claude/worktrees/
