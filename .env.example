# ═══════════════════════════════════════════════════════════════
# EDU-AGENT 配置模板 — 复制为 .env 后按实际情况修改
# 真实密钥只写入本地 .env（已被 .gitignore 忽略）
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider 凭证 ────────────────────────────
# 配了哪个 key 就启用哪个 provider（可同时配多个）。
# 至少需要配置一个，否则服务启动即报错。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 无密钥跑测试/CI 时置 true：默认模型切换为 fake，不会发起真实调用
USE_FAKE_MODEL=false

# ── LLM Provider 端点 ───────────────────────────
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_BASE=https://api.deepseek.com

# ── RAG 检索链使用的文本模型 ──────────────────────
# 格式为 <gateway>:<model_id>，网关决定用哪个 base 与 key：
#   dashscope:qwen3.8-max          通义千问，走阿里云百炼
#   deepseek:deepseek-v4-flash     DeepSeek 官方
#   dashscope:deepseek-v4-flash    同一个 DeepSeek 模型，改走阿里云百炼
# 同一个模型 ID 可以显式选择走哪家网关 —— 不是按模型名猜的。
LLM_MODEL=dashscope:qwen3.8-max
# with_structured_output：function_calling | json_mode | json_schema
# DashScope / DeepSeek 兼容端上 function_calling 最稳
STRUCTURED_OUTPUT_METHOD=function_calling

# ── Embedding（本地 TEI bge-m3）───────────────────
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=http://localhost:11435
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── Reranker（本地 TEI bge-reranker-base）──────
RERANK_ENABLED=true
RERANK_MODE=local
RERANK_LOCAL_URL=http://localhost:8080
RERANK_MIN_SCORE=0.3
RERANK_ABSOLUTE_MIN_SCORE=0.15

# ── HyDE（假设文档嵌入）─────────────────────────
HYDE_ENABLED=true
HYDE_MIN_DOCS=2
HYDE_RERANK_SCORE_THRESHOLD=0.25
HYDE_MAX_CHARS=500

# ── Semantic Cache（ChromaDB-backed）─────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88

# ── Token Budget ────────────────────────────────
CONTEXT_TOKEN_BUDGET=6000
CONTEXT_TOKEN_BUDGET_SHALLOW=3000
CONTEXT_TOKEN_BUDGET_DEEP=8000
MAX_STUDENT_PROFILE_TOKENS=800

# ── 超时（seconds）─────────────────────────────
LLM_TIMEOUT=90
PRE_RETRIEVAL_TIMEOUT=30
TOOL_CALL_TIMEOUT=30
EMBEDDING_TIMEOUT=60
RERANK_TIMEOUT=30

# ── Agent Temperature ──────────────────────────
TEMP_PRECISE=0.0
TEMP_CREATIVE=0.3
TEMP_DEFAULT=0.3

# ── ChromaDB ─────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8100

# ── Database（LangGraph checkpointer / store）───
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=checkpoints.db
SQLITE_STORE_PATH=store.db
# 短期：送入 LLM 的非 system 消息条数上限（0=不裁剪）
MEMORY_HISTORY_MAX_MESSAGES=20
# 长期 episodes：TTL 天数 / 每用户上限（0=关闭该项）
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_EPISODE_MAX_PER_USER=200
MEMORY_STORE_VECTOR_ENABLED=true

# ── Server ─────────────────────────────────────
HOST=127.0.0.1
PORT=8000
MODE=dev
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 前端（static/）由本服务提供，与 API 同源，无需跨域配置。
# 只有把前端单独部署到其他源时才需要在此追加对应 origin。
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Knowledge ──────────────────────────────────
KNOWLEDGE_DIR=./knowledge

# ── Auth（JWT，生产环境务必替换为随机密钥）──────
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ── 可观测性：LangSmith 追踪 ──────────────────────
# 开启后所有 LLM 调用链路会自动上报到 LangSmith（无需改代码），
# 可在平台查看每步的 prompt / 延迟 / token 用量与成本。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=edu-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
