# ═══════════════════════════════════════════════════════════════
# EDU-AGENT 配置模板 — 复制为 .env 后按实际情况修改
# 真实密钥只写入本地 .env（已被 .gitignore 忽略）
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider 凭证 ────────────────────────────
# 配了哪个 key 就启用哪个 provider（可同时配多个）。
# 至少需要配置一个，否则服务启动即报错。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 无密钥跑测试/CI 时置 true：默认模型切换为 fake，不会发起真实调用
USE_FAKE_MODEL=false

# 无 TEI 跑测试/CI 时置 true：embedding 改为本地确定性哈希向量，检索链不再依赖外部服务。
# 仅供测试（无真正语义泛化能力），生产必须为 false。
USE_FAKE_EMBEDDING=false

# 无 TEI 跑测试/CI 时置 true：rerank 改为本地确定性打分（字符 bigram 余弦），
# 使**重排链路**（预筛选/top_k 截断/双重阈值过滤）也能被门禁与单测覆盖。
# 仅供测试 —— 它只让管线可跑，不复制 bge-reranker 的分数分布，生产必须为 false。
USE_FAKE_RERANK=false

# ── LLM Provider 端点 ───────────────────────────
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_BASE=https://api.deepseek.com

# ── RAG 检索链使用的文本模型 ──────────────────────
# 格式为 <gateway>:<model_id>，网关决定用哪个 base 与 key：
#   dashscope:qwen3.8-max          通义千问，走阿里云百炼
#   deepseek:deepseek-v4-flash     DeepSeek 官方
#   dashscope:deepseek-v4-flash    同一个 DeepSeek 模型，改走阿里云百炼
# 同一个模型 ID 可以显式选择走哪家网关 —— 不是按模型名猜的。
LLM_MODEL=dashscope:qwen3.8-max
# with_structured_output：function_calling | json_mode | json_schema
# DashScope / DeepSeek 兼容端上 function_calling 最稳
STRUCTURED_OUTPUT_METHOD=function_calling

# ── Agent 层默认模型 ────────────────────────────
# supervisor / 专家未显式指定 model 时使用（走 get_model）。
# 留空则由已配置的网关自动推导 —— 推荐留空，避免与 LLM_MODEL 漂移。
DEFAULT_MODEL=

# ── Embedding（本地 TEI bge-m3）───────────────────
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=http://localhost:11435
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── Reranker（本地 TEI bge-reranker-v2-m3）──────
RERANK_ENABLED=true
RERANK_LOCAL_URL=http://localhost:11436
RERANK_MIN_SCORE=0.3
RERANK_ABSOLUTE_MIN_SCORE=0.15

# ── HyDE（假设文档嵌入）─────────────────────────
HYDE_ENABLED=true
HYDE_MIN_DOCS=2
HYDE_RERANK_SCORE_THRESHOLD=0.25
HYDE_MAX_CHARS=500

# ── Semantic Cache（ChromaDB-backed）─────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88

# ── 检索质量阈值 ────────────────────────────────
# ⚠️ 这三项在 import 期被读入模块常量，改完必须**重启服务**才生效。
# ⚠️ 改动后必须重跑 `python -m evaluation.retrieval_gate`，与基线比对。
# 命中分数低于此值的文档被丢弃
RETRIEVAL_SCORE_THRESHOLD=0.06
# RRF 融合里「语义默认路由」的基准权重
RRF_BASELINE_WEIGHT=1.5
# 重排候选数 = 最终保留条数 × 该倍率
RERANK_EXPAND_FACTOR=5

# ── BM25 候选池 ─────────────────────────────────
# 候选池 = k × FACTOR，下限为 FLOOR（0 = 不设下限）。
# ⚠️ 放宽候选池的收益已被证伪（backlog #34）：假 embedding 路由上 hit@1 +5pp，
#    真实 embedding 路由上收益为零（逐位相同）。默认值刻意保持现状，
#    这两项只是把它提成可测、可调的旋钮，**不改行为**。
# ★ 别按直觉把 FLOOR 设成 300 —— 见 #34 复测结论。
# 改动后需重启服务，并重跑 `python -m evaluation.retrieval_gate` 与基线比对。
BM25_CANDIDATE_FACTOR=3
BM25_CANDIDATE_FLOOR=0

# ── Token Budget ────────────────────────────────
CONTEXT_TOKEN_BUDGET=6000

# ── 超时（seconds）─────────────────────────────
LLM_TIMEOUT=90
PRE_RETRIEVAL_TIMEOUT=30
TOOL_CALL_TIMEOUT=30
EMBEDDING_TIMEOUT=60
RERANK_TIMEOUT=30

# ── Agent 行为 ──────────────────────────────────
# LangGraph 单轮的最大步数（supervisor ↔ 专家的每次往返都计入）。
# 触顶会中止本轮并返回兜底提示，调大可容纳更长的多专家协作。
AGENT_RECURSION_LIMIT=80

# ── Agent Temperature ──────────────────────────
TEMP_PRECISE=0.0
TEMP_CREATIVE=0.3
TEMP_DEFAULT=0.3

# ── ChromaDB ─────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8100

# ── Database（LangGraph checkpointer / store）───
SQLITE_DB_PATH=checkpoints.db
SQLITE_STORE_PATH=store.db

# ── 长期记忆 ────────────────────────────────────
# 短期：送入 LLM 的非 system 消息条数上限（0=不裁剪）
MEMORY_HISTORY_MAX_MESSAGES=20
# 长期 episodes：TTL 天数 / 每用户上限（0=关闭该项）
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_EPISODE_MAX_PER_USER=200
MEMORY_STORE_VECTOR_ENABLED=true
# 单次记忆写入超时（秒）与每次扫描的 episode 上限
MEMORY_WRITE_TIMEOUT=1.5
MEMORY_EPISODE_SCAN_LIMIT=50
# 掌握度判定：≥ GOOD_SCORE 算掌握，< WEAK_SCORE 算薄弱；
# 薄弱项连续命中 GOOD 达 WEAK_CLEAR_MIN_GOOD_HITS 次后清除标记
MEMORY_GOOD_SCORE=85.0
MEMORY_WEAK_SCORE=60.0
MEMORY_WEAK_MIN_HITS=2
MEMORY_WEAK_CLEAR_MIN_GOOD_HITS=2
# 薄弱知识点的统计窗口（天）
MEMORY_WEAK_WINDOW_DAYS=30
# 写入记忆前是否对隐私字段脱敏
MEMORY_PRIVACY_REDACT=true

# ── Server ─────────────────────────────────────
HOST=127.0.0.1
PORT=8000
MODE=dev
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 收到停止信号后，等待在途请求结束的秒数（超时则强制退出）
GRACEFUL_SHUTDOWN_TIMEOUT=30
# 前端（static/）由本服务提供，与 API 同源，无需跨域配置。
# 只有把前端单独部署到其他源时才需要在此追加对应 origin。
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Knowledge ──────────────────────────────────
KNOWLEDGE_DIR=./knowledge
# 入库后等待 Chroma 索引可查询的重试次数与间隔（秒）。
# 落盘有竞态，立即查询会间歇性报 "Nothing found on disk"。
INGEST_READY_RETRIES=8
INGEST_READY_DELAY=0.5
# 入库预热的最低成功率，低于此值视为入库异常
WARMUP_MIN_SUCCESS_RATE=0.8

# ── Auth（JWT，生产环境务必替换为随机密钥）──────
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ── 可观测性：LangSmith 追踪 ──────────────────────
# 开启后所有 LLM 调用链路会自动上报到 LangSmith（无需改代码），
# 可在平台查看每步的 prompt / 延迟 / token 用量与成本。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=edu-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
